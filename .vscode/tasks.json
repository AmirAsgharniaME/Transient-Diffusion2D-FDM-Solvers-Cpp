{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All (bear)",
            "type": "shell",
            "command": "bear",
            "args": ["--", "make", "rebuild"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build FTCS",
            "type": "shell",
            "command": "make",
            "args": ["ftcs"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build DuFort-Frankel",
            "type": "shell",
            "command": "make",
            "args": ["dufort"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Laasonen",
            "type": "shell",
            "command": "make",
            "args": ["laasonen"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Crank-Nicolson",
            "type": "shell",
            "command": "make",
            "args": ["crank"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Project",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": []
        }
    ]
